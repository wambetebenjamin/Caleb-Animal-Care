# ── Site ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Google reCAPTCHA (v3 everywhere, v2 fallback when score < 0.5) ──
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=        # v3 site key (client)
RECAPTCHA_SECRET_KEY=                  # v3 secret (server only)
NEXT_PUBLIC_RECAPTCHA_V2_SITE_KEY=     # v2 checkbox site key (low-score fallback)
RECAPTCHA_V2_SECRET_KEY=               # v2 secret (server only)

# ── Vercel KV (appointments, availability, subscribers, pets, orders) ──
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ── Vercel Blob (pet records, pet photos) ──
BLOB_READ_WRITE_TOKEN=

# ── NextAuth (pet portal) ──
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=                       # openssl rand -base64 32

# ── SMTP / Nodemailer ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Caleb Animal Care <no-reply@calebanimalcare.co.ke>"
CLINIC_EMAIL=info@calebanimalcare.co.ke

# ── WhatsApp Cloud API (confirmations + medication reminders) ──
WHATSAPP_TOKEN=                        # Meta system-user token
WHATSAPP_PHONE_ID=                     # WhatsApp Business phone number id
NEXT_PUBLIC_WHATSAPP_NUMBER=254112272061

# ── M-Pesa Daraja (shop checkout) ──
MPESA_ENV=sandbox                      # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.vercel.app/api/shop/order/callback

# ── Cron (medication reminder runner) ──
CRON_SECRET=
